# bblayers.conf template for AstraOS.
# Processed by scripts/setup-environment - placeholders are substituted at build-dir
# init time. Do not edit the generated build-<MACHINE>/conf/bblayers.conf directly;
# regenerate by re-sourcing setup-environment.

POKY_BBLAYERS_CONF_VERSION = "2"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

BBLAYERS = " \
  @SOURCES@/openembedded-core/meta \
  @SOURCES@/meta-yocto/meta-poky \
  @SOURCES@/meta-yocto/meta-yocto-bsp \
  @SOURCES@/meta-openembedded/meta-oe \
  @SOURCES@/meta-openembedded/meta-python \
  @SOURCES@/meta-openembedded/meta-networking \
  @SOURCES@/meta-openembedded/meta-multimedia \
  @SOURCES@/meta-openembedded/meta-filesystems \
  @SOURCES@/meta-openembedded/meta-perl \
  @SOURCES@/meta-qt6 \
  @SOURCES@/meta-lts-mixins \
  @SOURCES@/meta-rauc \
  @SOURCES@/meta-security \
  @SOURCES@/meta-security/meta-tpm \
  @SOURCES@/meta-astrax \
@MACHINE_LAYERS@\
"
