# local.conf template for AstraOS. @MACHINE@ and @BUILD_TYPE@ are
# substituted by scripts/setup-environment.
# Distro-wide settings live in meta-astrax/conf/distro/astraos.conf.

MACHINE ??= "@MACHINE@"
DISTRO ?= "astraos"

# Build type: "dev" (default) or "prod". Set by scripts/build prod-image,
# read by the conditional INHERIT below to scope production-only classes
# (cve-check, create-spdx) so dev iteration doesn't pay for a full CVE
# DB scan or SBOM generation.
ASTRAOS_BUILD_TYPE = "@BUILD_TYPE@"
INHERIT += "${@'cve-check create-spdx' if d.getVar('ASTRAOS_BUILD_TYPE') == 'prod' else ''}"

# PACKAGE_CLASSES is set in meta-astrax/conf/distro/astraos.conf - don't
# shadow it here. (Earlier this file hard-set package_ipk, which masked
# the distro's recent switch to package_rpm and produced an image with
# 7157 ipk files but no rpms or dnf metadata.)

# Default features for the active build dir; image recipes override
EXTRA_IMAGE_FEATURES ?= "read-only-rootfs"

USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"

BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

CONF_VERSION = "2"

# Uniform TMPDIR across all MACHINEs. Pre-wrynose bitbake also suffixed
# tmp/ with the C library name (-> tmp-glibc/) via a TCLIBCAPPEND .=
# in defaultsetup.conf, which required zeroing TCLIBCAPPEND here too.
# TCLIBCAPPEND was removed entirely as of wrynose bitbake - TMPDIR is
# no longer suffixed by anything, so setting it directly is sufficient.
#
# TMPDIR is in BB_HASHCONFIG_WHITELIST so sstate cache continues to
# hit; the only re-work on the next build is relinking + re-creating
# the tmp/ tree.
TMPDIR = "${TOPDIR}/tmp"

# Freescale/NXP proprietary binary userspace (imx-gpu-viv Vivante driver,
# imx-vpu-* codec libraries, firmware-imx-*) gates do_unpack on an explicit
# ACCEPT_FSL_EULA opt-in beyond LICENSE_FLAGS_ACCEPTED. The EULA file is at
# sources/meta-imx/LICENSE.txt - reviewed and accepted on behalf of AstraOS.
ACCEPT_FSL_EULA = "1"

# Variscite's var-uuu-installer (USB-boot factory-flashing helper) warns at
# parse time if VAR_FLASH_IMAGE_NAME is unset and silently defaults to
# fsl-image-gui-chromium (which we don't build). Point it at the matching
# AstraOS image so the warning goes away and, if VAR_UUU_INSTALL=true is
# ever set, the installer wraps the right rootfs.
VAR_FLASH_IMAGE_NAME = "${@'astraos-image' if d.getVar('ASTRAOS_BUILD_TYPE') == 'prod' else 'astraos-image-dev'}"

# Parallelism: use every core/thread the host offers. The build machine has
# 96 threads / 1 TB RAM, so memory pressure isn't a concern even at full
# concurrency. oe.utils.cpu_count() auto-adjusts on smaller hosts (a
# developer's --local laptop, etc.) so this stays portable.
BB_NUMBER_THREADS ?= "${@oe.utils.cpu_count()}"
PARALLEL_MAKE     ?= "-j ${@oe.utils.cpu_count()}"

# Reproducible builds (see docs/ARCHITECTURE.md - Compliance section)
BB_HASHSERVE = "auto"
BB_SIGNATURE_HANDLER = "OEEquivHash"

# Caches on the build machine, mounted into the container at the same
# path as on the host (NVMe-backed). scripts/build bind-mounts the host
# directories `${BUILDER_HOST_ROOT}/{sstate,downloads}` (default
# `/home/akothapalli/yocto/{sstate,downloads}`) onto these in-container
# paths. On a Mac running --local, scripts/build falls back to named
# docker volumes mounted at the same in-container paths so this stays
# portable.
#
# SSTATE_DIR is per-MACHINE so each target gets its own cache namespace.
# Trade-off: native/cross tools rebuild per MACHINE (some duplication);
# wins are clean per-machine wipe and zero risk of cross-MACHINE state
# bleed. DL_DIR stays shared (source tarballs are machine-independent).
SSTATE_DIR ?= "/home/akothapalli/yocto/sstate/${MACHINE}"
DL_DIR     ?= "/home/akothapalli/yocto/downloads"

# LICENSE_FLAGS_ACCEPTED is set in meta-astrax/conf/distro/astraos.conf -
# don't shadow it here. (Earlier this file hard-set the variable, which
# masked distro additions like synaptics-killswitch for RPi 5 firmware.)
