{
    "name": "AstraOS Yocto Build",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USER_UID": "${localEnv:UID:1000}",
            "USER_GID": "${localEnv:GID:1000}"
        }
    },

    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

    // sstate-cache and downloads at /cache/{sstate,downloads}
    // (matching local.conf.in). scripts/build bind-mounts host folders there;
    // in a VS Code devcontainer they are named volumes that survive container
    // rebuilds.
    "mounts": [
        "source=astraos-sstate-wrynose,target=/cache/sstate,type=volume",
        "source=astraos-downloads-wrynose,target=/cache/downloads,type=volume"
    ],

    "remoteUser": "builder",
    "containerUser": "builder",

    // Yocto and bind-mount safety
    "postCreateCommand": "sudo chown builder:builder /cache/sstate /cache/downloads && git config --global --add safe.directory '*'",

    // runArgs:
    //   --shm-size=2g           : default 64 MB is too small for some Qt6
    //                             cross-compile steps. (We do NOT build
    //                             qtwebengine/qtwebkit - lean SDK goal.)
    //   --security-opt apparmor=unconfined
    //                           : Ubuntu 24.04+ hosts default to
    //                             kernel.apparmor_restrict_unprivileged_userns=1
    //                             which blocks BitBake's `pseudo` (fakeroot
    //                             replacement) from creating unprivileged user
    //                             namespaces. Yocto builds fail at do_rootfs
    //                             without this. Container code is trusted
    //                             (your own Yocto build), so unconfining is
    //                             acceptable.
    //   --security-opt seccomp=unconfined
    //                           : belt-and-braces; some unshare() syscalls
    //                             on the pseudo path get caught by Docker's
    //                             default seccomp profile on certain kernels.
    "runArgs": [
        "--shm-size=2g",
        "--security-opt", "apparmor=unconfined",
        "--security-opt", "seccomp=unconfined"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "yocto-project.yocto-bitbake",
                "ms-azuretools.vscode-docker",
                "ms-python.python",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "files.watcherExclude": {
                    "**/build-*/**": true,
                    "**/sources/**": true,
                    "/cache/sstate/**": true,
                    "/cache/downloads/**": true
                }
            }
        }
    }
}
