#!/usr/bin/env bash
# AstraOS build helper.
#
# Single dispatcher for rebuilding the devcontainer, building image variants,
# building the cross-SDK, and bitbake-ing any single recipe.
#
# Defaults to remote execution against the AstraOS build machine
# (10.11.12.20 / Tailscale 100.82.113.92, ssh user akothapalli, passwordless
# key auth). Use --local to run against your local Docker daemon instead.
#
# Layered detection:
#   * --local on a Mac/dev box      docker run on local Docker
#   * default (no --local)          ssh akothapalli@10.11.12.20 then
#                                   docker run there
#   * already inside devcontainer   skip docker, just bash -c
#
# Usage:
#   scripts/build [--local | --remote] container
#   scripts/build [--local | --remote] image       <MACHINE>
#   scripts/build [--local | --remote] prod-image
#   scripts/build [--local | --remote] sdk         <MACHINE>
#   scripts/build [--local | --remote] recipe      <MACHINE> <RECIPE> [TASK]
#   scripts/build [--local | --remote] bitbake     <MACHINE> <args...>
#   scripts/build [--local | --remote] shell       <MACHINE>
#
# MACHINE: raspberrypi5 | raspberrypi-cm5-io-board | imx8mp-var-dart | astrax-variscite-imx8mp
#
# Override remote target with env vars (defaults shown):
#   ASTRAOS_BUILDER_HOST=10.11.12.20
#   ASTRAOS_BUILDER_USER=akothapalli
#   ASTRAOS_BUILDER_PORT=22
#   ASTRAOS_BUILDER_PATH=/home/akothapalli/yocto/astraos
#   ASTRAOS_BUILDER_HOST_ROOT=/home/akothapalli/yocto  (parent of sstate/downloads on host)

set -euo pipefail

ASTRAOS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INVOCATION_PWD="${PWD}"   # captured before any later cd; used by 'download'
IMAGE_TAG="astraos-builder:latest"

BUILDER_HOST="${ASTRAOS_BUILDER_HOST:-10.11.12.20}"
BUILDER_USER="${ASTRAOS_BUILDER_USER:-akothapalli}"
BUILDER_PORT="${ASTRAOS_BUILDER_PORT:-22}"
BUILDER_PATH="${ASTRAOS_BUILDER_PATH:-/home/akothapalli/yocto/astraos}"
# Parent dir on host: holds astraos/, sstate/, downloads/. /yocto/ used to
# live on a spinning disk; we now keep everything under the user's NVMe-
# backed home to avoid build I/O contention.
BUILDER_HOST_ROOT="${ASTRAOS_BUILDER_HOST_ROOT:-$(dirname "${BUILDER_PATH}")}"

# Canonical source of truth: GitHub.
ASTRAOS_GIT_URL="${ASTRAOS_GIT_URL:-https://github.com/kabhilash/astraos-manifests.git}"

MODE=""    # auto by default; set by --local / --remote

usage() {
    cat <<EOF
AstraOS build helper.

Usage (most subcommands accept an optional --local | --remote prefix):
  scripts/build container                              Rebuild the devcontainer image
  scripts/build clean                                  Wipe ${BUILDER_PATH} on builder + repo sync (sstate/downloads preserved)
  scripts/build image       <MACHINE>                  Build astraos-image-dev for MACHINE
  scripts/build prod-image                             Build astraos-image (mcb production)
  scripts/build sdk         <MACHINE>                  Build astraos-sdk for MACHINE
  scripts/build recipe      <MACHINE> <RECIPE> [TASK]  bitbake [-c TASK] RECIPE
  scripts/build bitbake     <MACHINE> <args...>        bitbake passthrough
  scripts/build shell       <MACHINE>                  Interactive shell, env sourced
  scripts/build download    <MACHINE> [<dest-dir>]     scp the latest dev wic.zst from the builder

MACHINE: raspberrypi5 | raspberrypi-cm5-io-board | imx8mp-var-dart | astrax-variscite-imx8mp

Default mode: --remote, dispatches via ssh to the build machine
  ${BUILDER_USER}@${BUILDER_HOST}:${BUILDER_PORT} (path: ${BUILDER_PATH})
Pass --local to run on the local Docker daemon instead.
EOF
    exit 1
}

_in_container() {
    [ -f /.dockerenv ] || [ -n "${REMOTE_CONTAINERS:-}" ]
}

_dockerfile_hash() {
    sha256sum "${ASTRAOS_ROOT}/.devcontainer/Dockerfile" 2>/dev/null | cut -d' ' -f1
}

# Rebuild the container whenever .devcontainer/Dockerfile changes. The
# Dockerfile's sha256 is stamped onto the image as a label; we compare
# the current file's hash to the label on each invocation. Skip when
# they match (fast: just a hash + docker inspect, ~50ms total).
_ensure_image() {
    local current_hash cached_hash
    current_hash=$(_dockerfile_hash)
    cached_hash=$(docker image inspect --format='{{index .Config.Labels "astraos.dockerfile_sha256"}}' "${IMAGE_TAG}" 2>/dev/null || echo "")
    if [ -n "${current_hash}" ] && [ "${current_hash}" = "${cached_hash}" ]; then
        return 0
    fi
    if [ -z "${cached_hash}" ]; then
        echo ">>> Container image missing; building..."
    else
        echo ">>> Dockerfile changed since last build; rebuilding container..."
    fi
    _build_container
}

_build_container() {
    local current_hash
    current_hash=$(_dockerfile_hash)
    docker build \
        --build-arg USER_UID="$(id -u 2>/dev/null || echo 1000)" \
        --build-arg USER_GID="$(id -g 2>/dev/null || echo 1000)" \
        --label "astraos.dockerfile_sha256=${current_hash}" \
        -t "${IMAGE_TAG}" \
        "${ASTRAOS_ROOT}/.devcontainer"
}

# Run a bash command inside the build env. On the host this docker-runs;
# inside the container it just bash -c's.
_run() {
    local cmd="$1"
    if _in_container; then
        bash -c "${cmd}"
    else
        _ensure_image
        # Bind host sstate/downloads from ${BUILDER_HOST_ROOT} when present
        # (build machine layout, NVMe-backed); otherwise use named docker
        # volumes mounted at the same in-container path. local.conf.in
        # references /home/akothapalli/yocto/{sstate,downloads} inside the
        # container regardless of the host source.
        local sstate_mount dl_mount
        if [ -d "${BUILDER_HOST_ROOT}/sstate" ]; then
            sstate_mount="-v ${BUILDER_HOST_ROOT}/sstate:/home/akothapalli/yocto/sstate"
        else
            sstate_mount="-v astraos-sstate:/home/akothapalli/yocto/sstate"
        fi
        if [ -d "${BUILDER_HOST_ROOT}/downloads" ]; then
            dl_mount="-v ${BUILDER_HOST_ROOT}/downloads:/home/akothapalli/yocto/downloads"
        else
            dl_mount="-v astraos-downloads:/home/akothapalli/yocto/downloads"
        fi
        # Bind ${BUILDER_PATH} as the workspace when running on the builder;
        # otherwise bind the local checkout dir.
        local workspace_src
        if [ -d "${BUILDER_PATH}" ] && [ "${ASTRAOS_ROOT}" = "${BUILDER_PATH}" ]; then
            workspace_src="${BUILDER_PATH}"
        else
            workspace_src="${ASTRAOS_ROOT}"
        fi
        # Bind host's ~/.ssh read-only into the container so bitbake's git
        # fetcher can clone private repos over SSH (astrax-bt lives on
        # AstraAnalytical, requires SSH auth). Host UID matches container
        # UID (USER_UID build-arg = host uid), so key file perms carry
        # through. RO mount means the container can't tamper with keys.
        local ssh_mount=""
        if [ -d "${HOME}/.ssh" ]; then
            ssh_mount="-v ${HOME}/.ssh:/home/builder/.ssh:ro"
        fi
        # -i and -t need a TTY at the caller's end. When running headless
        # (CI, run_in_background, scripted), drop them so docker doesn't
        # error with "cannot attach stdin to a TTY-enabled container".
        local docker_tty=""
        if [ -t 0 ] && [ -t 1 ]; then
            docker_tty="-it"
        fi
        docker run --rm ${docker_tty} \
            -v "${workspace_src}:/home/akothapalli/yocto/astraos" \
            ${sstate_mount} \
            ${dl_mount} \
            ${ssh_mount} \
            --shm-size=2g \
            --security-opt apparmor=unconfined \
            --security-opt seccomp=unconfined \
            -w /home/akothapalli/yocto/astraos \
            "${IMAGE_TAG}" \
            bash -lc "${cmd}"
    fi
}

# Validate MACHINE is one of the four known targets
_check_machine() {
    case "$1" in
        raspberrypi5|raspberrypi-cm5-io-board|imx8mp-var-dart|astrax-variscite-imx8mp) ;;
        *)
            echo "ERROR: unknown MACHINE '$1'" >&2
            echo "Valid: raspberrypi5, raspberrypi-cm5-io-board, imx8mp-var-dart, astrax-variscite-imx8mp" >&2
            exit 1
            ;;
    esac
}

# Short-circuit help / empty BEFORE any mode dispatch
case "${1:-}" in
    ""|-h|--help|help) usage ;;
esac

# Parse leading mode flag if present
case "${1:-}" in
    --local)  MODE=local;  shift ;;
    --remote) MODE=remote; shift ;;
esac

# Re-check after mode flag consumption
case "${1:-}" in
    ""|-h|--help|help) usage ;;
esac

# Auto-pick mode if user didn't specify
if [ -z "${MODE}" ]; then
    if _in_container; then
        MODE=local         # already inside the build env; just bash -c
    else
        MODE=remote        # default: dispatch to the build machine
    fi
fi

# download: scp the latest dev-image wic.zst from the builder to a local
# dir. Direct host-to-host transfer; no docker, no remote dispatch.
if [ "${1:-}" = "download" ]; then
    shift
    if _in_container; then
        echo "ERROR: 'download' runs on the host, not inside the container" >&2
        exit 1
    fi
    MACHINE="${1:-}"
    # Default dest = the dir the user ran scripts/build from (captured at
    # script start as INVOCATION_PWD). Lets you run the command from any
    # directory and have the wic land right there.
    DEST="${2:-${INVOCATION_PWD}}"
    if [ -z "${MACHINE}" ]; then
        echo "Usage: scripts/build download <MACHINE> [<dest-dir>]" >&2
        exit 1
    fi
    case "${MACHINE}" in
        raspberrypi5|raspberrypi-cm5-io-board|imx8mp-var-dart|astrax-variscite-imx8mp) ;;
        *)
            echo "ERROR: unknown MACHINE '${MACHINE}'" >&2
            exit 1
            ;;
    esac
    # TMPDIR varies: vanilla poky uses tmp/, but meta-imx sets
    # TMPDIR=${TOPDIR}/tmp-${LIBC} so variscite/mcb builds land in
    # tmp-glibc/. Probe both with a single ssh round-trip and pick the
    # one that exists.
    REMOTE_WIC_REL="deploy/images/${MACHINE}/astraos-image-dev-${MACHINE}.rootfs.wic.zst"
    BUILD_DIR="${BUILDER_PATH}/build-${MACHINE}"
    REMOTE_WIC=$(ssh -p "${BUILDER_PORT}" "${BUILDER_USER}@${BUILDER_HOST}" \
        "for d in tmp tmp-glibc; do f=${BUILD_DIR}/\$d/${REMOTE_WIC_REL}; [ -e \"\$f\" ] && { echo \"\$f\"; exit 0; }; done; exit 1")
    if [ -z "${REMOTE_WIC}" ]; then
        echo "ERROR: no wic.zst found under ${BUILD_DIR}/{tmp,tmp-glibc}/${REMOTE_WIC_REL}" >&2
        echo "       (did the build finish? try scripts/build image ${MACHINE} first)" >&2
        exit 1
    fi
    echo ">>> fetching ${REMOTE_WIC}"
    echo ">>>   from ${BUILDER_USER}@${BUILDER_HOST}"
    echo ">>>   to   ${DEST}/"
    # scp follows the .rootfs.wic.zst symlink and copies the underlying
    # timestamped file. -p preserves mtime so the file's age is preserved.
    exec scp -p -P "${BUILDER_PORT}" "${BUILDER_USER}@${BUILDER_HOST}:${REMOTE_WIC}" "${DEST}/"
fi

# clean: special-case dispatch BEFORE the cd-and-recurse remote pattern,
# because clean deletes the workspace it would otherwise cd into.
if [ "${1:-}" = "clean" ]; then
    if _in_container; then
        echo "ERROR: 'clean' must run from the host, not inside the container" >&2
        exit 1
    fi
    if [ "${MODE}" = "local" ]; then
        echo "ERROR: 'clean' targets the build machine; remove --local" >&2
        exit 1
    fi
    echo ">>> wiping ${BUILDER_PATH} on ${BUILDER_USER}@${BUILDER_HOST} and re-bootstrapping from GitHub"
    echo ">>> ${BUILDER_HOST_ROOT}/{sstate,downloads} preserved"
    if [ -t 0 ] && [ -t 1 ]; then
        clean_ssh_tty="-t"
    else
        clean_ssh_tty=""
    fi
    exec ssh ${clean_ssh_tty} -p "${BUILDER_PORT}" "${BUILDER_USER}@${BUILDER_HOST}" \
        ASTRAOS_GIT_URL="${ASTRAOS_GIT_URL}" BUILDER_PATH="${BUILDER_PATH}" 'bash -s' <<'REMOTE_CLEAN'
set -euo pipefail
cd /
rm -rf "${BUILDER_PATH}"
git clone "${ASTRAOS_GIT_URL}" "${BUILDER_PATH}"
cd "${BUILDER_PATH}"
echo ">>> HEAD = $(git log --oneline -1)"
echo ">>> repo init"
repo init -u "${ASTRAOS_GIT_URL}" -m manifests/default.xml --no-clone-bundle
echo ">>> repo sync"
repo sync -j16 --no-clone-bundle
echo ">>> sources/:"
ls "${BUILDER_PATH}/sources/" | sort
REMOTE_CLEAN
fi

# Remote dispatch: SSH to builder, sync workspace from GitHub, then
# re-invoke ourselves with --local. The sync makes sure the build runs
# against whatever the user just `git push origin`-ed.
#
# 'container' skips the sync (it doesn't depend on a fresh workspace and
# building a container is itself a setup step you might run before the
# workspace exists).
if [ "${MODE}" = "remote" ]; then
    quoted_args=$(printf '%q ' "$@")
    echo ">>> Dispatching to ${BUILDER_USER}@${BUILDER_HOST}:${BUILDER_PATH}"
    # Bootstrap the workspace + cache dirs on the builder when missing.
    # Idempotent: mkdir -p never errors on existing dirs, and the
    # clone/repo-sync block only runs when ${BUILDER_PATH}/.git is
    # absent. This means a brand-new builder (or one where the user
    # rm-rf'd the workspace) recovers automatically on the next build
    # command - no separate `clean` call required.
    bootstrap_step="mkdir -p \"${BUILDER_HOST_ROOT}/sstate\" \"${BUILDER_HOST_ROOT}/downloads\" && if [ ! -d \"${BUILDER_PATH}/.git\" ]; then echo \">>> bootstrapping workspace at ${BUILDER_PATH}\" && git clone \"${ASTRAOS_GIT_URL}\" \"${BUILDER_PATH}\" && cd \"${BUILDER_PATH}\" && repo init -u \"${ASTRAOS_GIT_URL}\" -m manifests/default.xml --no-clone-bundle && repo sync -j16 --no-clone-bundle; fi &&"
    # Always pull AstraOS to pick up Dockerfile / scripts / manifest
    # changes before any subcommand runs. Container previously skipped
    # this and built against a stale .devcontainer/Dockerfile.
    #
    # GitHub SSH occasionally drops connections from the build machine.
    # Retry git pull 3x with backoff so a transient blip doesn't kill
    # the chain. (repo sync has its own internal retry; only git pull
    # needs wrapping. repo sync is skipped for `container` since the
    # docker build doesn't touch sources/ layers.)
    pull_step="(for i in 1 2 3; do git -C ${BUILDER_PATH} pull --ff-only && break; echo \"git pull failed (attempt \$i), retrying in 10s\"; sleep 10; done) &&"
    case "${1:-}" in
        container)
            sync_step="${pull_step}"
            ;;
        *)
            sync_step="${pull_step} (cd ${BUILDER_PATH} && repo sync -j16 --no-clone-bundle) &&"
            ;;
    esac
    # -t forces TTY allocation, only viable when our own stdin IS a TTY.
    # Without a TTY, ssh -t fails with "Pseudo-terminal will not be allocated".
    if [ -t 0 ] && [ -t 1 ]; then
        ssh_tty="-t"
    else
        ssh_tty=""
    fi
    exec ssh ${ssh_tty} -p "${BUILDER_PORT}" "${BUILDER_USER}@${BUILDER_HOST}" \
        "${bootstrap_step} ${sync_step} cd ${BUILDER_PATH} && ./scripts/build --local ${quoted_args}"
fi

cmd="${1:-}"
shift || true

case "${cmd}" in
    container)
        _build_container
        ;;

    image)
        MACHINE="${1:-}"; [ -z "$MACHINE" ] && usage
        _check_machine "$MACHINE"
        _run "source scripts/setup-environment ${MACHINE} && bitbake astraos-image-dev"
        ;;

    prod-image)
        # ASTRAOS_BUILD_TYPE=prod enables the CVE database scan in
        # local.conf (see conf/local.conf.in conditional INHERIT).
        _run "ASTRAOS_BUILD_TYPE=prod source scripts/setup-environment astrax-variscite-imx8mp && bitbake astraos-image"
        ;;

    sdk)
        MACHINE="${1:-}"; [ -z "$MACHINE" ] && usage
        _check_machine "$MACHINE"
        _run "source scripts/setup-environment ${MACHINE} && bitbake astraos-sdk"
        ;;

    recipe)
        MACHINE="${1:-}"; RECIPE="${2:-}"; TASK="${3:-}"
        { [ -z "$MACHINE" ] || [ -z "$RECIPE" ]; } && usage
        _check_machine "$MACHINE"
        if [ -n "$TASK" ]; then
            _run "source scripts/setup-environment ${MACHINE} && bitbake -c ${TASK} ${RECIPE}"
        else
            _run "source scripts/setup-environment ${MACHINE} && bitbake ${RECIPE}"
        fi
        ;;

    bitbake)
        MACHINE="${1:-}"; [ -z "$MACHINE" ] && usage
        shift
        _check_machine "$MACHINE"
        _run "source scripts/setup-environment ${MACHINE} && bitbake $*"
        ;;

    shell)
        MACHINE="${1:-}"; [ -z "$MACHINE" ] && usage
        _check_machine "$MACHINE"
        _run "source scripts/setup-environment ${MACHINE} && exec bash"
        ;;

    ""|-h|--help|help)
        usage
        ;;

    *)
        echo "ERROR: unknown subcommand '${cmd}'" >&2
        usage
        ;;
esac
