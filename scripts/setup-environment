#!/usr/bin/env bash
# AstraOS build environment setup.
#
# Usage:    source scripts/setup-environment <MACHINE> [<build-dir>]
#           source scripts/setup-environment --help
#
# MACHINE may be:
#   raspberrypi5                 (RPi 5 dev)
#   raspberrypi-cm5-io-board     (RPi CM5 on the official CM5 IO Board, dev)
#   imx8mp-var-dart               (Variscite Symphony v1.7 dev - until mcb arrives)
#   astrax-variscite-imx8mp           (production, mcb carrier - hardware pending)
#
# Env vars consumed:
#   ASTRAOS_HOST_ROOT  = host path of the checkout when running in the
#     build container (set by scripts/build); only used for the summary.
#   ASTRAOS_BUILD_TYPE = dev|prod (default dev). When "prod", local.conf
#     inherits cve-check. scripts/build's prod-image subcommand sets this.
#
# After sourcing, you'll be in <build-dir>/ with bblayers.conf, local.conf,
# and the standard poky build env loaded (bitbake on PATH, etc.).

set -e

# Executed rather than sourced: BASH_SOURCE[0] is the script itself only
# then. Its `return`s below would fail, and the env it sets up would die
# with the subshell anyway. --help is fine either way.
if [ "${BASH_SOURCE[0]}" = "$0" ] && ! [[ "${1:-}" =~ ^(-h|--help|help)$ ]]; then
    echo "ERROR: setup-environment must be sourced, not executed:" >&2
    echo "       source scripts/setup-environment <MACHINE>" >&2
    exit 1
fi

# Resolve the AstraOS workspace root (parent of scripts/)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ASTRAOS_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SOURCES_DIR="${ASTRAOS_ROOT}/sources"

# Core layer: wrynose's manifest splits poky into bitbake + openembedded-core,
# scarthgap's keeps sources/poky (which includes both).
if [ -d "${SOURCES_DIR}/openembedded-core" ]; then
    CORE_DIR="openembedded-core"
else
    CORE_DIR="poky"
fi
# Yocto release of the checked-out layers, from LAYERSERIES_CORENAMES
# ("scarthgap", "wrynose", ...). A few things differ between releases and
# are handled below; both manifests (manifests/default.xml = scarthgap,
# manifests/wrynose.xml) share this script and conf/*.in.
RELEASE="$(sed -n 's/^LAYERSERIES_CORENAMES *= *"\([^" ]*\).*/\1/p' \
    "${SOURCES_DIR}/${CORE_DIR}/meta/conf/layer.conf" 2>/dev/null | head -n1)"
# Layers meta-imx-sdk needs on wrynose (its LAYERDEPENDS); not part of the
# scarthgap layer set.
WRYNOSE_IMX_LAYERS=""
# Core layers (@CORE_LAYERS@ in conf/bblayers.conf.in) and the Rust LTS mixin
# (@LTS_MIXINS_LAYER@, scarthgap only: wrynose ships a new enough Rust).
CORE_LAYERS="  ${SOURCES_DIR}/poky/meta \\
  ${SOURCES_DIR}/poky/meta-poky \\
  ${SOURCES_DIR}/poky/meta-yocto-bsp \\
"
LTS_MIXINS_LAYER="  ${SOURCES_DIR}/meta-lts-mixins \\
"
# Settings valid on scarthgap only: wrynose removed both variables and
# setting TCLIBCAPPEND there is a parse error.
RELEASE_CONF=""
case "${RELEASE}" in
    wrynose)
        CORE_LAYERS="  ${SOURCES_DIR}/openembedded-core/meta \\
  ${SOURCES_DIR}/meta-yocto/meta-poky \\
  ${SOURCES_DIR}/meta-yocto/meta-yocto-bsp \\
"
        LTS_MIXINS_LAYER=""
        WRYNOSE_IMX_LAYERS="  ${SOURCES_DIR}/meta-freescale-distro \\
  ${SOURCES_DIR}/meta-openembedded/meta-perl \\
"
        ;;
    *)
        RELEASE_CONF='# scarthgap: defaultsetup.conf appends "-${TCLIBC}" to TMPDIR via
# TCLIBCAPPEND, and that .= runs AFTER local.conf, so zero it out to keep the
# tmp-<MACHINE> layout. (AstraOS only ships glibc.)
TCLIBCAPPEND = ""

# scarthgap: meta-imx ships bbappends for FSL-distro recipes that do not exist
# in the astraos distro; bitbake treats orphan bbappends as fatal by default.
BB_DANGLINGAPPENDS_WARNONLY = "1"'
        ;;
esac

_astraos_usage() {
    cat <<EOF
AstraOS build environment setup. Must be sourced, not executed.

Usage:
  source scripts/setup-environment <MACHINE> [<build-dir>]
  source scripts/setup-environment -h | --help

MACHINE:
  raspberrypi5               Raspberry Pi 5 (dev)
  raspberrypi-cm5-io-board   Raspberry Pi CM5 on the CM5 IO Board (dev)
  imx8mp-var-dart            Variscite Symphony v1.7 (dev)
  astrax-variscite-imx8mp    mcb production carrier (hardware pending)

<build-dir>   relative to the checkout (${ASTRAOS_ROOT});
              default: build-<MACHINE>

Environment:
  ASTRAOS_BUILD_TYPE=dev|prod   default dev; prod enables cve-check in local.conf
  ASTRAOS_HOST_ROOT=<path>      only affects the BUILD_DIR line of the summary
                                (set by scripts/build inside the container)

Regenerates <build-dir>/conf/{bblayers,local}.conf on every run, puts
BitBake on PATH and leaves you in <build-dir>/. Needs sources/ from
'repo init && repo sync' (scripts/build does this for you).
EOF
}

case "${1:-}" in
    -h|--help|help)
        _astraos_usage
        unset -f _astraos_usage
        return 0 2>/dev/null || exit 0
        ;;
esac

if [ "$#" -lt 1 ]; then
    _astraos_usage >&2
    unset -f _astraos_usage
    return 1
fi
unset -f _astraos_usage

MACHINE="$1"
# Default to a per-MACHINE build dir so concurrent / interleaved builds for
# different targets don't trample each other's tmp/ or trigger OE-core's
# MACHINE-mismatch sanity error. DL_DIR is shared and SSTATE_DIR is keyed
# by MACHINE (see local.conf.in), so the only per-dir cost is conf/ + tmp/.
BUILD_DIR="${2:-build-${MACHINE}}"
BUILD_PATH="${ASTRAOS_ROOT}/${BUILD_DIR}"

# dev | prod. Templated into local.conf to gate prod-only INHERITs
# (cve-check today; potentially signing/dm-verity-related toggles later).
ASTRAOS_BUILD_TYPE="${ASTRAOS_BUILD_TYPE:-dev}"
case "${ASTRAOS_BUILD_TYPE}" in
    dev|prod) ;;
    *)
        echo "ERROR: ASTRAOS_BUILD_TYPE='${ASTRAOS_BUILD_TYPE}' (must be 'dev' or 'prod')" >&2
        return 1
        ;;
esac

# Per-MACHINE BBLAYERS extensions
case "$MACHINE" in
    raspberrypi5|raspberrypi-cm5-io-board)
        MACHINE_LAYERS="  ${SOURCES_DIR}/meta-raspberrypi \\
  ${SOURCES_DIR}/meta-astrax-raspberrypi \\
"
        ;;
    imx8mp-var-dart|astrax-variscite-imx8mp)
        # NXP i.MX BSP stack must be listed before the Variscite layers
        # so the fsl-bsp-release / meta-freescale collections are
        # discovered first. meta-variscite-hab is BBLAYERS-included only
        # for the production MACHINE (mcb) where HABv4 signing matters;
        # imx8mp-var-dart (Symphony dev board) skips it.
        MACHINE_LAYERS="  ${SOURCES_DIR}/meta-arm/meta-arm \\
  ${SOURCES_DIR}/meta-arm/meta-arm-toolchain \\
  ${SOURCES_DIR}/meta-clang \\
  ${SOURCES_DIR}/meta-freescale \\
${WRYNOSE_IMX_LAYERS}  ${SOURCES_DIR}/meta-virtualization \\
  ${SOURCES_DIR}/meta-imx/meta-imx-bsp \\
  ${SOURCES_DIR}/meta-imx/meta-imx-sdk \\
  ${SOURCES_DIR}/meta-variscite-bsp-common \\
  ${SOURCES_DIR}/meta-variscite-bsp-imx \\
  ${SOURCES_DIR}/meta-variscite-sdk-common \\
  ${SOURCES_DIR}/meta-variscite-sdk-imx \\
  ${SOURCES_DIR}/meta-astrax-variscite \\
"
        if [ "${MACHINE}" = "astrax-variscite-imx8mp" ]; then
            MACHINE_LAYERS="${MACHINE_LAYERS}  ${SOURCES_DIR}/meta-variscite-hab \\
"
        fi
        ;;
    *)
        echo "ERROR: unknown MACHINE '${MACHINE}'" >&2
        echo "Valid: raspberrypi5, raspberrypi-cm5-io-board, imx8mp-var-dart, astrax-variscite-imx8mp" >&2
        return 1
        ;;
esac

# Initialize the build dir using oe-core's helper (sets PATH, exports BB_ENV_*, etc.)
if [ ! -d "${SOURCES_DIR}/${CORE_DIR}" ]; then
    echo "ERROR: ${SOURCES_DIR}/${CORE_DIR} not found - run 'repo init && repo sync' first" >&2
    return 1
fi

# shellcheck disable=SC1091
source "${SOURCES_DIR}/${CORE_DIR}/oe-init-build-env" "${BUILD_PATH}" >/dev/null

# Always regenerate bblayers.conf and local.conf on every source so that
# bblayers picks up MACHINE_LAYERS changes (e.g. meta-raspberrypi vs.
# meta-variscite-*) without manual edits.
#
# Use bash builtin substring replacement instead of sed - sed's
# replacement-string parser collapses multi-line values (MACHINE_LAYERS
# has newlines) onto a single line, breaking BBLAYERS parsing.
bblayers="$(<"${ASTRAOS_ROOT}/conf/bblayers.conf.in")"
bblayers="${bblayers//@SOURCES@/${SOURCES_DIR}}"
bblayers="${bblayers//@TOPDIR@/${ASTRAOS_ROOT}}"
bblayers="${bblayers//@MACHINE_LAYERS@/${MACHINE_LAYERS}}"
bblayers="${bblayers//@CORE_LAYERS@/${CORE_LAYERS}}"
bblayers="${bblayers//@LTS_MIXINS_LAYER@/${LTS_MIXINS_LAYER}}"
printf '%s' "${bblayers}" > "${BUILD_PATH}/conf/bblayers.conf"

local_conf="$(<"${ASTRAOS_ROOT}/conf/local.conf.in")"
local_conf="${local_conf//@MACHINE@/${MACHINE}}"
local_conf="${local_conf//@BUILD_TYPE@/${ASTRAOS_BUILD_TYPE}}"
local_conf="${local_conf//@RELEASE_CONF@/${RELEASE_CONF}}"
printf '%s' "${local_conf}" > "${BUILD_PATH}/conf/local.conf"

echo ""
echo "AstraOS build env ready."
echo "  MACHINE          = ${MACHINE}"
if [ -n "${ASTRAOS_HOST_ROOT:-}" ]; then
    # In the container the checkout is mounted at ASTRAOS_ROOT; show where
    # the build dir really lives on the host.
    echo "  BUILD_DIR        = ${ASTRAOS_HOST_ROOT}/${BUILD_DIR}"
else
    echo "  BUILD_DIR        = ${BUILD_PATH}"
fi
echo "  ASTRAOS_BUILD_TYPE = ${ASTRAOS_BUILD_TYPE}"
echo ""
echo "Next:"
echo "  bitbake astraos-image-dev      # dev variant"
echo "  bitbake astraos-image          # production (only on astrax-variscite-imx8mp)"
echo ""
