#!/usr/bin/env bash
# AstraOS build environment setup.
#
# Usage:    source scripts/setup-environment <MACHINE> [<build-dir>]
#
# MACHINE may be:
#   raspberrypi5                 (RPi 5 dev)
#   raspberrypi-cm5-io-board     (RPi CM5 on the official CM5 IO Board, dev)
#   imx8mp-var-dart               (Variscite Symphony v1.7 dev - until mcb arrives)
#   astrax-variscite-imx8mp           (production, mcb carrier - hardware pending)
#
# Env vars consumed:
#   ASTRAOS_BUILD_TYPE = dev|prod (default dev). When "prod", local.conf
#     inherits cve-check. scripts/build's prod-image subcommand sets this.
#
# After sourcing, you'll be in <build-dir>/ with bblayers.conf, local.conf,
# and the standard poky build env loaded (bitbake on PATH, etc.).

set -e

if [ -z "${BASH_SOURCE[0]}" ]; then
    echo "ERROR: setup-environment must be sourced (not executed)." >&2
    exit 1
fi

# Resolve the AstraOS workspace root (parent of scripts/)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ASTRAOS_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SOURCES_DIR="${ASTRAOS_ROOT}/sources"

if [ "$#" -lt 1 ]; then
    echo "Usage: source scripts/setup-environment <MACHINE> [<build-dir>]" >&2
    return 1
fi

MACHINE="$1"
# Default to a per-MACHINE build dir so concurrent / interleaved builds for
# different targets don't trample each other's tmp/ or trigger OE-core's
# MACHINE-mismatch sanity error. DL_DIR is shared and SSTATE_DIR is keyed
# by MACHINE (see local.conf.in), so the only per-dir cost is conf/ + tmp/.
BUILD_DIR="${2:-build-${MACHINE}}"
BUILD_PATH="${ASTRAOS_ROOT}/${BUILD_DIR}"

# dev | prod. Templated into local.conf to gate prod-only INHERITs
# (cve-check today; potentially signing/dm-verity-related toggles later).
ASTRAOS_BUILD_TYPE="${ASTRAOS_BUILD_TYPE:-dev}"
case "${ASTRAOS_BUILD_TYPE}" in
    dev|prod) ;;
    *)
        echo "ERROR: ASTRAOS_BUILD_TYPE='${ASTRAOS_BUILD_TYPE}' (must be 'dev' or 'prod')" >&2
        return 1
        ;;
esac

# Per-MACHINE BBLAYERS extensions
case "$MACHINE" in
    raspberrypi5|raspberrypi-cm5-io-board)
        MACHINE_LAYERS="  ${SOURCES_DIR}/meta-raspberrypi \\
  ${SOURCES_DIR}/meta-astrax-raspberrypi \\
"
        ;;
    imx8mp-var-dart|astrax-variscite-imx8mp)
        # NXP i.MX BSP stack must be listed before the Variscite layers
        # so the fsl-bsp-release / meta-freescale collections are
        # discovered first. meta-variscite-hab is BBLAYERS-included only
        # for the production MACHINE (mcb) where HABv4 signing matters;
        # imx8mp-var-dart (Symphony dev board) skips it.
        MACHINE_LAYERS="  ${SOURCES_DIR}/meta-arm/meta-arm \\
  ${SOURCES_DIR}/meta-arm/meta-arm-toolchain \\
  ${SOURCES_DIR}/meta-clang \\
  ${SOURCES_DIR}/meta-freescale \\
  ${SOURCES_DIR}/meta-freescale-distro \\
  ${SOURCES_DIR}/meta-virtualization \\
  ${SOURCES_DIR}/meta-imx/meta-imx-bsp \\
  ${SOURCES_DIR}/meta-imx/meta-imx-sdk \\
  ${SOURCES_DIR}/meta-variscite-bsp-common \\
  ${SOURCES_DIR}/meta-variscite-bsp-imx \\
  ${SOURCES_DIR}/meta-variscite-sdk-common \\
  ${SOURCES_DIR}/meta-variscite-sdk-imx \\
  ${SOURCES_DIR}/meta-astrax-variscite \\
"
        if [ "${MACHINE}" = "astrax-variscite-imx8mp" ]; then
            MACHINE_LAYERS="${MACHINE_LAYERS}  ${SOURCES_DIR}/meta-variscite-hab \\
"
        fi
        ;;
    *)
        echo "ERROR: unknown MACHINE '${MACHINE}'" >&2
        echo "Valid: raspberrypi5, raspberrypi-cm5-io-board, imx8mp-var-dart, astrax-variscite-imx8mp" >&2
        return 1
        ;;
esac

# Initialize the build dir using openembedded-core's helper (sets PATH,
# exports BB_ENV_*, etc.). Since wrynose, poky is no longer a single combined
# repo - bitbake and openembedded-core are separate sibling checkouts under
# sources/; oe-init-build-env finds bitbake via that sibling directory.
if [ ! -d "${SOURCES_DIR}/openembedded-core" ]; then
    echo "ERROR: ${SOURCES_DIR}/openembedded-core not found - run 'repo init && repo sync' first" >&2
    return 1
fi
if [ ! -d "${SOURCES_DIR}/bitbake" ]; then
    echo "ERROR: ${SOURCES_DIR}/bitbake not found - run 'repo init && repo sync' first" >&2
    return 1
fi

# shellcheck disable=SC1091
source "${SOURCES_DIR}/openembedded-core/oe-init-build-env" "${BUILD_PATH}" >/dev/null

# Always regenerate bblayers.conf and local.conf on every source so that
# bblayers picks up MACHINE_LAYERS changes (e.g. meta-raspberrypi vs.
# meta-variscite-*) without manual edits.
#
# Use bash builtin substring replacement instead of sed - sed's
# replacement-string parser collapses multi-line values (MACHINE_LAYERS
# has newlines) onto a single line, breaking BBLAYERS parsing.
bblayers="$(<"${ASTRAOS_ROOT}/conf/bblayers.conf.in")"
bblayers="${bblayers//@SOURCES@/${SOURCES_DIR}}"
bblayers="${bblayers//@TOPDIR@/${ASTRAOS_ROOT}}"
bblayers="${bblayers//@MACHINE_LAYERS@/${MACHINE_LAYERS}}"
printf '%s' "${bblayers}" > "${BUILD_PATH}/conf/bblayers.conf"

local_conf="$(<"${ASTRAOS_ROOT}/conf/local.conf.in")"
local_conf="${local_conf//@MACHINE@/${MACHINE}}"
local_conf="${local_conf//@BUILD_TYPE@/${ASTRAOS_BUILD_TYPE}}"
printf '%s' "${local_conf}" > "${BUILD_PATH}/conf/local.conf"

echo ""
echo "AstraOS build env ready."
echo "  MACHINE          = ${MACHINE}"
echo "  BUILD_DIR        = ${BUILD_PATH}"
echo "  ASTRAOS_BUILD_TYPE = ${ASTRAOS_BUILD_TYPE}"
echo ""
echo "Next:"
echo "  bitbake astraos-image-dev      # dev variant"
echo "  bitbake astraos-image          # production (only on astrax-variscite-imx8mp)"
echo ""
