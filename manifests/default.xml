<?xml version="1.0" encoding="UTF-8"?>
<!--
  AstraOS google-repo manifest.

  Pulls every layer needed to build either dev (raspberrypi5/raspberrypi-cm5-io-board/imx8mp-var-dart)
  or production (astraos-imx8mp-mcb) image variants. The MACHINE-specific layer
  selection happens in conf/bblayers.conf.in via scripts/setup-environment.

  TODO: SHAs marked with revision="scarthgap" should be pinned to specific
  commits before production use. Variscite-controlled SHAs are already pinned
  to the L6.6.52_2.2.2 release (var01-2.2.2-v1.2).
-->
<manifest>

  <remote name="yocto"     fetch="https://git.yoctoproject.org/"/>
  <remote name="oe"        fetch="https://git.openembedded.org/"/>
  <remote name="varigit"   fetch="https://github.com/varigit/"/>
  <remote name="qt"        fetch="https://code.qt.io/yocto/"/>
  <remote name="rauc"      fetch="https://github.com/rauc/"/>
  <remote name="kabhilash" fetch="https://github.com/kabhilash/"/>
  <!-- NXP i.MX BSP stack -->
  <remote name="nxp-imx"   fetch="https://github.com/nxp-imx/"/>
  <remote name="freescale" fetch="https://github.com/Freescale/"/>
  <remote name="kraj"      fetch="https://github.com/kraj/"/>

  <default revision="scarthgap" remote="yocto" sync-j="4"/>

  <!-- Yocto core -->
  <project name="poky" path="sources/poky" remote="yocto" revision="scarthgap"/>

  <!-- OpenEmbedded -->
  <project name="meta-openembedded" path="sources/meta-openembedded" remote="oe" revision="scarthgap"/>

  <!-- Raspberry Pi BSP -->
  <project name="meta-raspberrypi" path="sources/meta-raspberrypi" remote="yocto" revision="scarthgap"/>

  <!-- Qt 6.8.3 LTS - meta-qt6 uses Qt-version branch names, not Yocto release names -->
  <project name="meta-qt6" path="sources/meta-qt6" remote="qt"
           revision="00c3bd954341a2a755fdee6b978af952f51793e7"
           upstream="6.8.3"/>

  <!-- Latest Rust on Scarthgap via LTS mixin -->
  <!-- TODO: pin SHA -->
  <project name="meta-lts-mixins" path="sources/meta-lts-mixins" remote="yocto" revision="scarthgap/rust"/>

  <!-- RAUC update framework -->
  <!-- TODO: pin SHA -->
  <project name="meta-rauc" path="sources/meta-rauc" remote="rauc" revision="scarthgap"/>

  <!-- meta-security: provides packagegroup-security-tpm2 (meta-tpm sub-layer)
       used by astraos-image-dev. Pinned to Variscite's v1.2 SHA for
       known-good compatibility with the NXP/scarthgap stack. -->
  <project name="meta-security" path="sources/meta-security" remote="yocto"
           revision="b13f1705d723650de61277670c8a76aadea4cfdd"
           upstream="scarthgap"/>

  <!-- Variscite BSP layers + the NXP i.MX BSP stack they sit on top of.
       SHAs are taken verbatim from Variscite's reference manifest for
       the L6.6.52-2.2.2 release:
         varigit/variscite-bsp-platform @ scarthgap/imx-6.6.52-2.2.2.xml
       The kernel (varigit/linux-imx) and U-Boot (varigit/uboot-imx)
       source trees are fetched by the BSP recipes themselves via
       SRC_URI at build time; they're not separate manifest projects.

       NXP-side stack (provides the fsl-bsp-release collection,
       toolchain bits, Freescale BSP, virt support). -->
  <project name="meta-arm" path="sources/meta-arm" remote="yocto"
           revision="0a4b911d9fd63ab29c4532a907fae3282dbdcfe4"
           upstream="scarthgap"/>
  <project name="meta-freescale" path="sources/meta-freescale" remote="freescale"
           revision="ce51eb5486e87a34f04f0367351e3217855b17ba"
           upstream="scarthgap"/>
  <project name="meta-freescale-3rdparty" path="sources/meta-freescale-3rdparty" remote="freescale"
           revision="ce10c065119c2d4e359235c77aae7e0d843533ef"
           upstream="scarthgap"/>
  <project name="meta-freescale-distro" path="sources/meta-freescale-distro" remote="freescale"
           revision="b9d6a5d9931922558046d230c1f5f4ef6ee72345"
           upstream="scarthgap"/>
  <project name="meta-virtualization" path="sources/meta-virtualization" remote="yocto"
           revision="ee1ec1ee542389a3fc3692fdd232f9dd86c849a5"
           upstream="scarthgap"/>
  <project name="meta-clang" path="sources/meta-clang" remote="kraj"
           revision="cc29beb210ab94eacc53bbd67e287e4e33ede342"
           upstream="scarthgap"/>
  <project name="meta-imx" path="sources/meta-imx" remote="nxp-imx"
           revision="refs/tags/rel_imx_6.6.52_2.2.2"
           upstream="scarthgap-6.6.52-2.2.2"/>

  <!-- Variscite layers (pinned to scarthgap_6.6.52-2.2.2_var01). -->
  <project name="meta-variscite-bsp-common" path="sources/meta-variscite-bsp-common" remote="varigit"
           revision="2a03434fe537c93e008ce31c664ebe174aa82340"
           upstream="scarthgap_6.6.52-2.2.2_var01"/>
  <project name="meta-variscite-bsp-imx" path="sources/meta-variscite-bsp-imx" remote="varigit"
           revision="1211b1406c42fc7749fb6413debcd6a4e0792d50"
           upstream="scarthgap_6.6.52-2.2.2_var01"/>
  <project name="meta-variscite-sdk-common" path="sources/meta-variscite-sdk-common" remote="varigit"
           revision="7b45393620f4496b4dfac1b5a71245377a8ccbde"
           upstream="scarthgap_6.6.52-2.2.2_var01"/>
  <project name="meta-variscite-sdk-imx" path="sources/meta-variscite-sdk-imx" remote="varigit"
           revision="75853a038ec4686bd5b834062ba4987ace8ec816"
           upstream="scarthgap_6.6.52-2.2.2_var01"/>
  <!-- meta-variscite-hab provides HABv4 signing for production builds
       (astraos-imx8mp-mcb). Synced unconditionally, wired into BBLAYERS
       only by setup-environment when building production. -->
  <project name="meta-variscite-hab" path="sources/meta-variscite-hab" remote="varigit"
           revision="e9ba2f5099939df9bcbdf540192f21ecbea3de08"
           upstream="scarthgap_6.6.52-2.2.2_var01"/>

  <!-- Astra-owned layers (separate repos under github.com/kabhilash; SSH URLs).
       The build machine needs an SSH key with read access to each repo (deploy
       key, account-level key, or org-level key when these eventually move to
       an Astra org). -->
  <project name="meta-astrax"             path="sources/meta-astrax"             remote="kabhilash" revision="main"/>
  <project name="meta-astrax-raspberrypi" path="sources/meta-astrax-raspberrypi" remote="kabhilash" revision="main"/>
  <project name="meta-astrax-variscite"   path="sources/meta-astrax-variscite"   remote="kabhilash" revision="main"/>

</manifest>
